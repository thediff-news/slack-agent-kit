{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts", "sdk-app/src/**/*.ts", "sdk-app/tests/**/*.ts", "sdk-app/*.mts"]
}
